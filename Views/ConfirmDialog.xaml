<Window x:Class="WakeOnLan.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar"
        Width="440"
        Background="{StaticResource WindowFallbackBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="40">
            <TextBlock Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Wake on LAN" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,20" Background="{StaticResource FooterBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="120" Click="Primary_Click" Style="{StaticResource DangerButton}">
                    <TextBlock x:Name="PrimaryText" />
                </Button>
                <Button MinWidth="120" Margin="8,0,0,0" Content="Cancelar" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
