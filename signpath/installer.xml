<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration de SignPath con slug "installer".
  Firma el instalador de Inno Setup, que ya contiene los ejecutables firmados.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" default-value="0.0.0" />
  </parameters>
  <zip-file>
    <pe-file path="WakeOnLan-${version}-setup.exe" product-name="Wake on LAN" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
