<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration de SignPath con slug "app".
  Firma los ejecutables de la aplicación antes de construir el instalador.
  El ZIP lo genera actions/upload-artifact a partir de la carpeta artifacts/.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" default-value="0.0.0" />
  </parameters>
  <zip-file>
    <pe-file path="publish/WakeOnLan.exe" product-name="Wake on LAN" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="publish/WakeOnLan.dll" product-name="Wake on LAN" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="publish-portable/WakeOnLan.exe" product-name="Wake on LAN" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
