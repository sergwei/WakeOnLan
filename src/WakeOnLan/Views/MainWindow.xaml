<Window x:Class="WakeOnLan.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:WakeOnLan.Models"
        Title="Wake on LAN"
        Width="1000"
        Height="660"
        MinWidth="760"
        MinHeight="480"
        Background="{StaticResource WindowFallbackBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ContextMenu x:Key="DeviceMenu" x:Shared="False">
            <MenuItem Click="MenuWake_Click" Header="Encender" Tag="&#xE7E8;" />
            <MenuItem Click="MenuFavorite_Click">
                <MenuItem.Style>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                        <Setter Property="Header" Value="Añadir a favoritos" />
                        <Setter Property="Tag" Value="&#xE734;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Header" Value="Quitar de favoritos" />
                                <Setter Property="Tag" Value="&#xE735;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Click="MenuEdit_Click" Header="Editar" Tag="&#xE70F;" />
            <MenuItem Click="MenuCopyMac_Click" Header="Copiar dirección MAC" Tag="&#xE8C8;" />
            <Separator />
            <MenuItem Click="MenuDelete_Click" Header="Eliminar" Tag="&#xE74D;" />
        </ContextMenu>

        <ContextMenu x:Key="MoreMenu" x:Shared="False">
            <MenuItem Click="WakeAll_Click" Header="Encender todos" Tag="&#xE7E8;" />
            <Separator />
            <MenuItem Click="Import_Click" Header="Importar dispositivos…" Tag="&#xE8B5;" />
            <MenuItem Click="Export_Click" Header="Exportar dispositivos…" Tag="&#xEDE1;" />
            <MenuItem Click="OpenDataFolder_Click" Header="Abrir carpeta de datos" Tag="&#xE838;" />
            <Separator />
            <!-- Casilla: el icono de verificación aparece cuando está activo. -->
            <MenuItem Click="ToggleStartup_Click" Header="Iniciar con Windows (en la bandeja)">
                <MenuItem.Style>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                        <Setter Property="Tag" Value="" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RunAtStartup}" Value="True">
                                <Setter Property="Tag" Value="&#xE73E;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="DeviceItem" TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
            <Setter Property="ContextMenu" Value="{StaticResource DeviceMenu}" />
        </Style>

        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type m:Device}">
            <Grid Margin="14,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icono con indicador de estado -->
                <Grid Width="40" Height="40" VerticalAlignment="Center">
                    <Border Background="#12FFFFFF" CornerRadius="8" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Style="{StaticResource IconText}"
                               Text="&#xE977;" />
                    <Ellipse x:Name="Dot"
                             Width="12"
                             Height="12"
                             Margin="0,0,-3,-3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Fill="{StaticResource NeutralBrush}"
                             Stroke="#202020"
                             StrokeThickness="2" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Border x:Name="Chip"
                            Padding="10,3"
                            HorizontalAlignment="Right"
                            Background="#1A9D9D9D"
                            CornerRadius="10">
                        <TextBlock x:Name="ChipText"
                                   FontSize="12"
                                   Foreground="{StaticResource NeutralBrush}"
                                   Text="{Binding StatusText}" />
                    </Border>
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="{Binding LastSeen, Converter={StaticResource LastSeen}}" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="StarButton"
                            Margin="0,0,4,0"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Añadir a favoritos">
                        <TextBlock x:Name="Star"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Style="{StaticResource IconText}"
                                   Text="&#xE734;" />
                    </Button>
                    <Button Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Enviar paquete mágico">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;" />
                            <TextBlock Margin="8,0,0,0" Text="Encender" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0,0,0"
                            Click="RowMore_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Más opciones">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE712;" />
                    </Button>
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource CautionBrush}" />
                    <Setter TargetName="StarButton" Property="ToolTip" Value="Quitar de favoritos" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Online">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="Chip" Property="Background" Value="#266CCB5F" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="Chip" Property="Background" Value="#26FF99A4" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waking">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CautionBrush}" />
                    <Setter TargetName="Chip" Property="Background" Value="#26FCE100" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource CautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título (zona de arrastre) -->
        <StackPanel x:Name="TitleBar" Height="40" Margin="16,0,0,0" Orientation="Horizontal">
            <TextBlock Foreground="{StaticResource AccentBrush}" Style="{StaticResource IconText}" Text="&#xE7E8;" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Wake on LAN" />
        </StackPanel>

        <!-- Cabecera -->
        <Grid Grid.Row="1" Margin="24,4,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontFamily="{StaticResource DisplayFont}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="Dispositivos" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding SummaryText}" />
            </StackPanel>
            <Grid Grid.Column="1" Width="300" VerticalAlignment="Bottom">
                <TextBox x:Name="SearchBox"
                         Padding="34,7,10,7"
                         Tag="Buscar por nombre, IP o MAC"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="12,0,0,0"
                           HorizontalAlignment="Left"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsHitTestVisible="False"
                           Style="{StaticResource IconText}"
                           Text="&#xE721;" />
            </Grid>
        </Grid>

        <!-- Barra de acciones -->
        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="WakeSelectedButton"
                        Click="WakeSelected_Click"
                        IsEnabled="False"
                        Style="{StaticResource AccentButton}"
                        ToolTip="Encender los dispositivos seleccionados">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;" />
                        <TextBlock x:Name="WakeSelectedText" Margin="8,0,0,0" Text="Encender" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="Add_Click" ToolTip="Añadir dispositivo (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                        <TextBlock Margin="8,0,0,0" Text="Añadir" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="Scan_Click" ToolTip="Buscar equipos en tu red local">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE839;" />
                        <TextBlock Margin="8,0,0,0" Text="Escanear red" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" ToolTip="Actualizar estado (F5)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                </Button>
                <Button Margin="4,0,0,0" Click="More_Click" Style="{StaticResource IconButton}" ToolTip="Más opciones">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE712;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Lista / estados vacíos / notificación -->
        <Grid Grid.Row="3">
            <ListBox x:Name="DeviceList"
                     Padding="24,0,24,24"
                     ItemContainerStyle="{StaticResource DeviceItem}"
                     ItemTemplate="{StaticResource DeviceTemplate}"
                     ItemsSource="{Binding DevicesView}"
                     MouseDoubleClick="DeviceList_MouseDoubleClick"
                     SelectionChanged="DeviceList_SelectionChanged"
                     SelectionMode="Extended"
                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Margin="24,32,24,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Ningún dispositivo coincide con la búsqueda."
                       Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Margin="24,0,24,60"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Width="72" Height="72" HorizontalAlignment="Center" Background="{StaticResource CardBrush}" CornerRadius="36">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="30"
                               Foreground="{StaticResource AccentBrush}"
                               Style="{StaticResource IconText}"
                               Text="&#xE7E8;" />
                </Border>
                <TextBlock Margin="0,20,0,6"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Aún no tienes dispositivos" />
                <TextBlock MaxWidth="400"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Escanea tu red para encontrarlos automáticamente o añade uno a mano con su dirección MAC."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Click="Scan_Click" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE839;" />
                            <TextBlock Margin="8,0,0,0" Text="Escanear red" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Click="Add_Click" Content="Añadir manualmente" />
                </StackPanel>
            </StackPanel>

            <Border MaxWidth="560"
                    Margin="24,0,24,20"
                    Padding="16,10,8,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource FlyoutBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.35" ShadowDepth="4" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="16">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource IconText}" TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE73E;" />
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               Text="{Binding ToastMessage}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Padding="6"
                            MinWidth="28"
                            MinHeight="28"
                            VerticalAlignment="Center"
                            Click="CloseToast_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Cerrar">
                        <TextBlock FontSize="10" Style="{StaticResource IconText}" Text="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Pie -->
        <TextBlock Grid.Row="4"
                   Margin="24,0,24,12"
                   FontSize="12"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   Text="Doble clic para editar · Supr para eliminar · Clic derecho para más opciones · Minimiza para usarla desde la bandeja" />
    </Grid>
</Window>
