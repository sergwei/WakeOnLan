<Window x:Class="WakeOnLan.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:WakeOnLan.Models"
        Title="Wake on LAN · Favoritos"
        Width="340"
        Background="{StaticResource FlyoutBrush}"
        BorderBrush="{StaticResource ControlBorderBrush}"
        BorderThickness="1"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown"
        ResizeMode="NoResize"
        ShowActivated="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Topmost="True"
        WindowStyle="None">

    <Window.Resources>
        <DataTemplate x:Key="FavoriteTemplate" DataType="{x:Type m:Device}">
            <Border x:Name="Row" Padding="10,8" Background="Transparent" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="Dot"
                             Width="10"
                             Height="10"
                             VerticalAlignment="Center"
                             Fill="{StaticResource NeutralBrush}" />

                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusLabel"
                                   Margin="0,1,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>

                    <Button x:Name="WakeButton"
                            Grid.Column="2"
                            MinHeight="28"
                            Padding="10,3"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            FontSize="13"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Enviar paquete mágico">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Style="{StaticResource IconText}" Text="&#xE7E8;" />
                            <TextBlock Margin="6,0,0,0" Text="Encender" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource CardHoverBrush}" />
                </Trigger>
                <!-- Encendido: no hace falta el botón. -->
                <DataTrigger Binding="{Binding Status}" Value="Online">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="WakeButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waking">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CautionBrush}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource CautionBrush}" />
                    <Setter TargetName="WakeButton" Property="IsEnabled" Value="False" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Margin="16,14,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Favoritos" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding FavoritesSummary}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="Actualizar estado">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
            </Button>
        </Grid>

        <!-- Lista de favoritos -->
        <Grid Grid.Row="1" Margin="6,0,6,8">
            <ScrollViewer MaxHeight="360"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemTemplate="{StaticResource FavoriteTemplate}" ItemsSource="{Binding Favorites}" />
            </ScrollViewer>

            <StackPanel Margin="10,8,10,12" Visibility="{Binding HasFavorites, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock FontSize="13" Text="Aún no tienes favoritos" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap">
                    <Run Text="Abre la aplicación y marca la estrella" />
                    <Run FontFamily="{StaticResource IconFont}" Text="&#xE734;" />
                    <Run Text="de los equipos que quieras tener a mano aquí." />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Pie -->
        <Border Grid.Row="2" Padding="8,6" Background="{StaticResource FooterBrush}">
            <Grid>
                <Button HorizontalAlignment="Left" Click="Open_Click" Style="{StaticResource IconButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" Text="Abrir Wake on LAN" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Right" Click="Exit_Click" Style="{StaticResource IconButton}" ToolTip="Cerrar la aplicación">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" Text="Salir" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
